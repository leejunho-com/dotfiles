#!/usr/bin/env bash
# cut fanart.jpg to poster.jpg
# usage:
#   poster                          right edge (default)
#   poster l|ml|m|mr|r              5-step preset positions
#   poster <ratio>                  custom x ratio (0.0 ~ 0.5275)
#   poster -i|--input <file>        custom input file (default: fanart.jpg)
#   poster -d|--dir <path>          fanart.jpg beside <path> (a file's dir, or the dir itself)
#   poster -a|--append <pos>        append position to filename (poster-<pos>.jpg)
#
# output goes next to the input file. -d takes an absolute path so it works from
# yazi search results, where the cwd stays at the search origin.

set -euo pipefail

poster() {
  local append=0
  local input="fanart.jpg"

  while [[ "${1:-}" == -* ]]; do
    case "$1" in
      -a|--append) append=1; shift ;;
      -i|--input)  input="$2"; shift 2 ;;
      -d|--dir)    if [[ -d "$2" ]]; then input="$2/fanart.jpg"; else input="$(dirname "$2")/fanart.jpg"; fi; shift 2 ;;
      *) break ;;
    esac
  done

  local pos="${1:-r}"
  local x
  case "$pos" in
    l)      x=0 ;;
    ml)     x=0.1318 ;;
    m)      x=0.2638 ;;
    mr)     x=0.3956 ;;
    r|"")   x=0.5275 ;;
    *)      x="$pos" ;;
  esac

  # write next to the input, not the caller's cwd
  local dir output
  dir="$(dirname "$input")"
  output="$dir/poster.jpg"
  (( append )) && output="$dir/poster-$pos.jpg"

  # -y: overwrite without prompting — no tty when called from yazi
  ffmpeg -y -i "$input" -vf "crop=iw*0.4725:ih:iw*$x:0" -update 1 "$output"
}

poster "$@"
