#!/usr/bin/env bash
# mirror files below cwd into ./dummy/ as zero-byte files
# usage: dummy [-r]   -> -r walks the whole tree, otherwise cwd only

set -euo pipefail

recursive=false
out=dummy

while (($#)); do
	case $1 in
	-r | --recursive) recursive=true ;;
	*)
		echo "unknown option: $1" >&2
		exit 2
		;;
	esac
	shift
done

depth=(-maxdepth 1)
if $recursive; then depth=(); fi

mkdir -p "$out"
while IFS= read -r -d '' f; do
	rel=${f#./}
	mkdir -p "$out/$(dirname -- "$rel")"
	: >"$out/$rel"
done < <(find . "${depth[@]}" -type f ! -path "./$out/*" -print0)

echo "done"
